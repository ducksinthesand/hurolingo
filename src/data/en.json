    { "id": "en-54", "original": "go jump in a lake", "phonetic": "goh jump in uh layk", "translation": "get lost", "translation_de": "geh zum Teufel", "literal": "spring in einen See", "note": "Sanfte Variante von 'get lost'. Sicher für alle Altersgruppen.", "category": "frustration", "severity": 1, "variants": null },
    { "id": "en-55", "original": "you've got a screw loose", "phonetic": "yoov got uh skroo loos", "translation": "you're a bit crazy", "translation_de": "bei dir ist eine Schraube locker", "literal": "du hast eine lockere Schraube", "note": "Mechanische Metapher für geistige Instabilität. Auch auf Deutsch eine gängige Redewendung.", "category": "playful", "severity": 1, "variants": null },
    { "id": "en-56", "original": "shut your gob", "phonetic": "shut yor gob", "translation": "shut your mouth", "translation_de": "halt die Klappe", "literal": "halt dein Maul", "note": "'Gob' ist britisches Slang für Mund. Direkter als 'be quiet', weniger direkt als Schlimmeres.", "category": "frustration", "severity": 2, "variants": ["en-GB"] },
