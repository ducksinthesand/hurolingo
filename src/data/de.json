{
  "code": "de",
  "name": "German",
  "native": "Deutsch",
  "flag": "🇩🇪",
  "status": "full",
  "variants": [{ "code": "de-DE", "name": "Standard German", "flag": "🇩🇪" }],
  "entries": [
    { "id": "de-01", "original": "Mist", "phonetic": "mist", "translation": "crap / darn", "literal": "manure", "note": "Completely socially acceptable — German grandmas say it hourly.", "category": "public", "severity": 1, "variants": null },
    { "id": "de-02", "original": "Verdammt", "phonetic": "fair-DAMT", "translation": "damn it", "literal": "damned", "note": "The standard reaction to a missed train, i.e. said rarely — German trains are never late (joke).", "category": "public", "severity": 1, "variants": null },
    { "id": "de-03", "original": "Blödsinn", "phonetic": "BLERD-zin", "translation": "nonsense / rubbish", "literal": "stupid sense", "note": "Perfect for dismissing an argument without swearing.", "category": "public", "severity": 1, "variants": null },
    { "id": "de-04", "original": "Depp", "phonetic": "dep", "translation": "fool", "literal": "fool", "note": "In Bavaria almost a term of endearment.", "category": "banter", "severity": 1, "variants": null },
    { "id": "de-05", "original": "Trottel", "phonetic": "TROT-tel", "translation": "dimwit", "literal": "dawdler", "note": "Classic Austrian favourite; mild and slightly affectionate.", "category": "banter", "severity": 1, "variants": null },
    { "id": "de-06", "original": "Dummkopf", "phonetic": "DOOM-kopf", "translation": "blockhead", "literal": "dumb head", "note": "The one German insult every cartoon villain taught the world.", "category": "playful", "severity": 1, "variants": null },
    { "id": "de-07", "original": "Schwachkopf", "phonetic": "SHVAKH-kopf", "translation": "numbskull", "literal": "weak head", "note": "A slightly fancier Dummkopf.", "category": "banter", "severity": 1, "variants": null },
    { "id": "de-08", "original": "Spinner", "phonetic": "SHPIN-ner", "translation": "nutcase", "literal": "spinner", "note": "From 'spinnen' — to spin yarn, i.e. to talk crazy. 'Du spinnst!' = you're nuts!", "category": "banter", "severity": 1, "variants": null },
    { "id": "de-09", "original": "Weichei", "phonetic": "VYKH-eye", "translation": "wimp", "literal": "soft egg", "note": "Part of a whole family of wimp-insults Germans invent for fun.", "category": "playful", "severity": 1, "variants": null },
    { "id": "de-10", "original": "Warmduscher", "phonetic": "VARM-doo-sher", "translation": "softie", "literal": "warm-showerer", "note": "Someone too soft to shower cold. Peak German compound-word comedy.", "category": "playful", "severity": 1, "variants": null },
    { "id": "de-11", "original": "Schattenparker", "phonetic": "SHAT-ten-par-ker", "translation": "wimp", "literal": "shadow-parker", "note": "A man who parks in the shade so the car stays cool. Devastating.", "category": "playful", "severity": 1, "variants": null },
    { "id": "de-12", "original": "Lappen", "phonetic": "LAP-pen", "translation": "loser / wet rag", "literal": "rag", "note": "Youth slang; also what you lose when caught speeding (the licence).", "category": "banter", "severity": 1, "variants": null },
    { "id": "de-13", "original": "Pfeife", "phonetic": "PFY-fuh", "translation": "useless person", "literal": "whistle", "note": "Someone who just blows air. Popular with football coaches.", "category": "banter", "severity": 1, "variants": null },
    { "id": "de-14", "original": "Flasche", "phonetic": "FLA-shuh", "translation": "failure", "literal": "bottle", "note": "Empty on the inside. 'Flasche leer!' became legendary via coach Trapattoni's meltdown.", "category": "banter", "severity": 1, "variants": null },
    { "id": "de-15", "original": "Niete", "phonetic": "NEE-tuh", "translation": "dud", "literal": "losing lottery ticket", "note": "A person who never wins anything, including arguments.", "category": "banter", "severity": 1, "variants": null },
    { "id": "de-16", "original": "Angsthase", "phonetic": "ANGST-hah-zuh", "translation": "scaredy-cat", "literal": "fear-rabbit", "note": "Kind enough for kindergarten, pointed enough for your hiking buddy.", "category": "playful", "severity": 1, "variants": null },
    { "id": "de-17", "original": "Faulpelz", "phonetic": "FOWL-pelts", "translation": "lazybones", "literal": "lazy pelt", "note": "For the flatmate whose dishes have achieved sentience.", "category": "playful", "severity": 1, "variants": null },
    { "id": "de-18", "original": "Schnarchnase", "phonetic": "SHNARKH-nah-zuh", "translation": "slowpoke", "literal": "snore-nose", "note": "For people who are asleep even while awake.", "category": "playful", "severity": 1, "variants": null },
    { "id": "de-19", "original": "Klugscheißer", "phonetic": "KLOOG-shy-ser", "translation": "smart-ass", "literal": "smart-shitter", "note": "The person who corrects your grammar mid-argument.", "category": "banter", "severity": 2, "variants": null },
    { "id": "de-20", "original": "Korinthenkacker", "phonetic": "ko-RIN-ten-KAK-ker", "translation": "nitpicker", "literal": "currant-crapper", "note": "Someone whose pedantry produces output as tiny as currants.", "category": "banter", "severity": 2, "variants": null },
    { "id": "de-21", "original": "Erbsenzähler", "phonetic": "AIRB-zen-tsay-ler", "translation": "bean counter", "literal": "pea-counter", "note": "The accountant of joy. Counts peas, kills vibes.", "category": "playful", "severity": 1, "variants": null },
    { "id": "de-22", "original": "Sesselpupser", "phonetic": "ZES-sel-POOP-ser", "translation": "desk jockey", "literal": "armchair-farter", "note": "Office worker who has never lifted anything heavier than a stapler.", "category": "playful", "severity": 1, "variants": null },
    { "id": "de-23", "original": "Suppenkasper", "phonetic": "ZOOP-pen-KAS-per", "translation": "picky eater", "literal": "soup-Kasper", "note": "From the 1845 children's book Struwwelpeter — the boy who refused his soup.", "category": "playful", "severity": 1, "variants": null },
    { "id": "de-24", "original": "Quatschkopf", "phonetic": "KVATCH-kopf", "translation": "silly-billy", "literal": "nonsense-head", "note": "Affectionate; safe to use on children and CEOs alike.", "category": "playful", "severity": 1, "variants": null },
    { "id": "de-25", "original": "Labertasche", "phonetic": "LAH-ber-TA-shuh", "translation": "chatterbox", "literal": "blabber-bag", "note": "For the friend whose voice memos are 11 minutes long.", "category": "playful", "severity": 1, "variants": null },
    { "id": "de-26", "original": "Hosenscheißer", "phonetic": "HOH-zen-SHY-ser", "translation": "chicken / coward", "literal": "pants-shitter", "note": "Vulgar but mostly used teasingly among friends.", "category": "banter", "severity": 2, "variants": null },
    { "id": "de-27", "original": "Halbdackel", "phonetic": "HALP-dak-kel", "translation": "half-wit", "literal": "half a dachshund", "note": "Swabian speciality: a full Dackel (dachshund) is already an insult — this is half of one.", "category": "banter", "severity": 2, "variants": null },
    { "id": "de-28", "original": "Honk", "phonetic": "honk", "translation": "dork", "literal": "(nonsense word)", "note": "Youth slang, allegedly from 'Hauptschüler ohne nennenswerte Kenntnisse'.", "category": "banter", "severity": 1, "variants": null },
    { "id": "de-29", "original": "Pappnase", "phonetic": "PAP-nah-zuh", "translation": "clown", "literal": "cardboard nose", "note": "The red carnival nose — calling someone one means they're a joke.", "category": "playful", "severity": 1, "variants": null },
    { "id": "de-30", "original": "Knalltüte", "phonetic": "KNAL-tuu-tuh", "translation": "nutjob", "literal": "banging bag", "note": "A party popper of a person: loud, sudden, no content.", "category": "banter", "severity": 1, "variants": null },
    { "id": "de-31", "original": "Dumpfbacke", "phonetic": "DOOMPF-bak-kuh", "translation": "airhead", "literal": "dull cheek", "note": "Popularised by the German dub of 'Married... with Children'.", "category": "banter", "severity": 1, "variants": null },
    { "id": "de-32", "original": "Lauch", "phonetic": "lowkh", "translation": "weakling", "literal": "leek", "note": "Gym-culture slang: thin, pale, bends easily.", "category": "banter", "severity": 1, "variants": null },
    { "id": "de-33", "original": "Rotzlöffel", "phonetic": "ROTS-lerf-fel", "translation": "cheeky brat", "literal": "snot-spoon", "note": "Reserved for other people's children.", "category": "playful", "severity": 1, "variants": null },
    { "id": "de-34", "original": "Jammerlappen", "phonetic": "YAM-mer-LAP-pen", "translation": "whiner", "literal": "whining rag", "note": "For people who complain about the weather. So, everyone.", "category": "banter", "severity": 1, "variants": null },
    { "id": "de-35", "original": "Miesepeter", "phonetic": "MEE-zuh-PAY-ter", "translation": "sourpuss", "literal": "grumpy Peter", "note": "Poor Peter. Nobody knows what he did to deserve this.", "category": "playful", "severity": 1, "variants": null },
    { "id": "de-36", "original": "Stinkstiefel", "phonetic": "SHTINK-shtee-fel", "translation": "grump", "literal": "stinky boot", "note": "Radiates bad mood the way an old boot radiates smell.", "category": "playful", "severity": 1, "variants": null },
    { "id": "de-37", "original": "Schwachmat", "phonetic": "SHVAKH-maht", "translation": "dimwit", "literal": "weak-mate", "note": "Colloquial blend of 'schwach' (weak) and 'Schachmatt' (checkmate).", "category": "banter", "severity": 1, "variants": null },
    { "id": "de-38", "original": "Scheiße", "phonetic": "SHY-suh", "translation": "shit", "literal": "shit", "note": "Statistically Germany's most-used word after 'ja'. Fits every situation.", "category": "frustration", "severity": 2, "variants": null },
    { "id": "de-39", "original": "Blödmann", "phonetic": "BLERD-man", "translation": "dummy", "literal": "stupid man", "note": "Mild classic; the German equivalent of calling someone a doofus.", "category": "banter", "severity": 1, "variants": null },
    { "id": "de-40", "original": "Vollidiot", "phonetic": "FOL-ee-dee-OHT", "translation": "total idiot", "literal": "full idiot", "note": "The 'Voll-' prefix upgrades any insult to premium.", "category": "frustration", "severity": 2, "variants": null },
    { "id": "de-41", "original": "Vollpfosten", "phonetic": "FOL-pfos-ten", "translation": "complete moron", "literal": "full fence post", "note": "As smart and useful as a wooden post. Standard traffic commentary.", "category": "frustration", "severity": 2, "variants": null },
    { "id": "de-42", "original": "Arschgeige", "phonetic": "ARSH-guy-guh", "translation": "jerk", "literal": "arse-violin", "note": "Nobody knows what an arse-violin is, which makes it perfect.", "category": "banter", "severity": 2, "variants": null },
    { "id": "de-43", "original": "Arschkriecher", "phonetic": "ARSH-kree-kher", "translation": "kiss-ass", "literal": "arse-crawler", "note": "For colleagues whose agreement with the boss is load-bearing.", "category": "banter", "severity": 2, "variants": null },
    { "id": "de-44", "original": "Mistkerl", "phonetic": "MIST-kairl", "translation": "scumbag", "literal": "manure guy", "note": "Old-fashioned but heartfelt; what your Oma calls TV villains.", "category": "frustration", "severity": 2, "variants": null },
    { "id": "de-45", "original": "Drecksack", "phonetic": "DREK-zak", "translation": "dirtbag", "literal": "sack of dirt", "note": "Serious insult — the friendship discount does not apply.", "category": "nuclear", "severity": 3, "variants": null },
    { "id": "de-46", "original": "Kotzbrocken", "phonetic": "KOTS-bro-ken", "translation": "obnoxious jerk", "literal": "chunk of vomit", "note": "Reserved for people who are exhausting on a molecular level.", "category": "nuclear", "severity": 3, "variants": null },
    { "id": "de-47", "original": "Arschloch", "phonetic": "ARSH-lokh", "translation": "asshole", "literal": "arse-hole", "note": "The heavyweight champion. Also a popular German card game, confusingly.", "category": "nuclear", "severity": 3, "variants": null },
    { "id": "de-48", "original": "Verpiss dich", "phonetic": "fair-PISS dikh", "translation": "piss off", "literal": "piss yourself away", "note": "Ends conversations. Occasionally friendships.", "category": "nuclear", "severity": 3, "variants": null },
    { "id": "de-49", "original": "Leck mich am Arsch", "phonetic": "LEK mikh am ARSH", "translation": "kiss my ass", "literal": "lick me on the arse", "note": "Literary pedigree: Goethe put it in a play in 1773. National treasure.", "category": "nuclear", "severity": 3, "variants": null },
    { "id": "de-50", "original": "Hurensohn", "phonetic": "HOO-ren-zohn", "translation": "son of a bitch", "literal": "son of a whore", "note": "Extremely strong — fight-starter territory. Know it, don't throw it.", "category": "nuclear", "severity": 3, "variants": null }
  ]
}
