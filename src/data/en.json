    { "id": "en-11", "original": "smartass", "phonetic": "SMART-ass", "translation": "smart aleck", "literal": "clever arse", "note": "Spelled 'smart-arse' in the UK and Australia, naturally.", "category": "banter", "severity": 2, "variants": null },
    { "id": "en-12", "original": "jerk", "phonetic": "jurk", "translation": "jerk", "literal": "sudden pull", "note": "America's everyday word for a selfish person.", "category": "frustration", "severity": 1, "variants": ["en-US"] },
