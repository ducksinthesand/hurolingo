  "entries": [
    { "id": "fr-01", "original": "zut", "phonetic": "zuut", "translation": "darn", "translation_de": "Mist", "literal": "Mist", "note": "Der mildeste französische Fluch; was Lehrer sagen, wenn sie die Kreide fallen lassen.", "category": "public", "severity": 1, "variants": null },
    { "id": "fr-02", "original": "mince", "phonetic": "manss", "translation": "shoot", "translation_de": "Mist / Schande", "literal": "dünn", "note": "Höflicher Ersatz für 'merde', wie 'Mist' statt... du weißt schon.", "category": "public", "severity": 1, "variants": null },
    { "id": "fr-03", "original": "andouille", "phonetic": "ahn-DOO-yuh", "translation": "dummy", "translation_de": "Trottel", "literal": "Kutteln-Wurst", "note": "Als Wurst bezeichnet zu werden ist ein französisches Initiationsritual.", "category": "playful", "severity": 1, "variants": null },
    { "id": "fr-04", "original": "cornichon", "phonetic": "kor-nee-SHOHN", "translation": "dope", "translation_de": "Dummkopf", "literal": "kleines Gürkchen", "note": "Frankreich beleidigt dich mit Charcuterie-Zutaten. Respekt.", "category": "playful", "severity": 1, "variants": null },
    { "id": "fr-05", "original": "patate", "phonetic": "pah-TAHT", "translation": "silly", "translation_de": "Dummkopf / Trottel", "literal": "Kartoffel", "note": "Liebevoll. 'Grosse patate' unter Freunden ist fast Zuneigung.", "category": "playful", "severity": 1, "variants": null },
    { "id": "fr-06", "original": "banane", "phonetic": "bah-NAHN", "translation": "goof", "translation_de": "Trottel", "literal": "Banane", "note": "Ja, die Obst-Beleidigungsfamilie ist in Frankreich groß.", "category": "playful", "severity": 1, "variants": null },
    { "id": "fr-07", "original": "nouille", "phonetic": "NOO-yuh", "translation": "noodle / dimwit", "translation_de": "Nudel / Weichling", "literal": "Nudel", "note": "Weich, schlaff, kein Rückgrat. Die Metapher schreibt sich selbst.", "category": "playful", "severity": 1, "variants": null },
    { "id": "fr-08", "original": "cruche", "phonetic": "kruush", "translation": "airhead", "translation_de": "Hohlkopf", "literal": "Krug", "note": "Leeres Gefäß, macht Geräusche wenn man draufklopft.", "category": "playful", "severity": 1, "variants": null },
    { "id": "fr-09", "original": "gourde", "phonetic": "goord", "translation": "dimwit", "translation_de": "Dummkopf", "literal": "Feldflasche / Kürbis", "note": "Wie cruche, aber mit Outdoor-Shop-Energie.", "category": "playful", "severity": 1, "variants": null },
    { "id": "fr-10", "original": "truffe", "phonetic": "truuf", "translation": "dolt", "translation_de": "Trottel", "literal": "Trüffel", "note": "Der teuerste Pilz wird zur billigsten Beleidigung.", "category": "playful", "severity": 1, "variants": null },
    { "id": "fr-11", "original": "quiche", "phonetic": "keesh", "translation": "klutz", "translation_de": "Versager / Trottel", "literal": "Quiche", "note": "Moderner Slang: 'être une quiche en maths' = in Mathe hoffnungslos sein.", "category": "playful", "severity": 1, "variants": null },
    { "id": "fr-12", "original": "boulet", "phonetic": "boo-LEH", "translation": "dead weight", "translation_de": "Klotz am Bein", "literal": "Kanonenkugel (an einer Kette)", "note": "Der Freund, den die Gruppe wie eine Gefangenenkugel mitschleppt.", "category": "banter", "severity": 1, "variants": null },
    { "id": "fr-13", "original": "râleur", "phonetic": "rah-LUHR", "translation": "whiner", "translation_de": "Jammerlappen", "literal": "Stöhner", "note": "Klagen ist Nationalsport; ein râleur ist sein Profi-Athlet.", "category": "banter", "severity": 1, "variants": null },
    { "id": "fr-14", "original": "mytho", "phonetic": "mee-TOH", "translation": "liar", "translation_de": "Lügner", "literal": "Kurzform von Mythomane", "note": "Jugendslang für jemanden, dessen Geschichten einen Netflix-Deal verdienen.", "category": "banter", "severity": 1, "variants": null },
    { "id": "fr-15", "original": "guignol", "phonetic": "geen-YOL", "translation": "clown", "translation_de": "Clown / Kasper", "literal": "die Puppe Guignol", "note": "Vom berühmten Lyoner Puppentheater. 'Arrête ton guignol' = hör auf zu clownen.", "category": "banter", "severity": 1, "variants": null },
    { "id": "fr-16", "original": "bouffon", "phonetic": "boo-FOHN", "translation": "clown / fool", "translation_de": "Hofnarr / Clown", "literal": "Hofnarr", "note": "Durch Banlieue-Slang wiederbelebt; die Lieferung ist wichtiger als das Wort.", "category": "banter", "severity": 2, "variants": null },
    { "id": "fr-17", "original": "blaireau", "phonetic": "bleh-ROH", "translation": "loser", "translation_de": "Versager", "literal": "Dachs", "note": "Warum der Dachs? Niemand weiß es. Der Dachs hat nichts falsch gemacht.", "category": "banter", "severity": 2, "variants": null },
    { "id": "fr-18", "original": "ringard", "phonetic": "ran-GAR", "translation": "uncool / has-been", "translation_de": "uncool / veraltet", "literal": "Schürhaken", "note": "Tödlich in Paris, wo veraltet sein schlimmer ist als unhöflich sein.", "category": "banter", "severity": 1, "variants": null },
    { "id": "fr-19", "original": "radin", "phonetic": "rah-DAN", "translation": "cheapskate", "translation_de": "Geizhals", "literal": "Geizkragen", "note": "Für den Freund, der vier Abendessen in Folge 'seine Geldbörse vergessen' hat.", "category": "banter", "severity": 1, "variants": null },
    { "id": "fr-20", "original": "flemmard", "phonetic": "fleh-MAR", "translation": "lazybones", "translation_de": "Faulpelz", "literal": "einer voller 'flemme'", "note": "'J'ai la flemme' (keine Lust) ist ein vollständiger französischer Satz und Lebensstil.", "category": "playful", "severity": 1, "variants": null },
    { "id": "fr-21", "original": "tête de mule", "phonetic": "tet duh MUUL", "translation": "stubborn as a mule", "translation_de": "stur wie ein Esel", "literal": "Maultierkopf", "note": "Standardausrüstung für Familienstreitigkeiten.", "category": "banter", "severity": 1, "variants": null },
    { "id": "fr-22", "original": "casse-pieds", "phonetic": "kass-PYEH", "translation": "pain in the neck", "translation_de": "Nervensäge", "literal": "Fußbrecher", "note": "Die höfliche Version eines viel weniger höflichen Ausdrucks weiter unten.", "category": "banter", "severity": 1, "variants": null },
    { "id": "fr-23", "original": "gros nul", "phonetic": "groh NUUL", "translation": "big loser", "translation_de": "totaler Versager", "literal": "große Null", "note": "Schulhof-Klassiker; skaliert vom Spielplatz bis ins Büro.", "category": "banter", "severity": 1, "variants": null },
    { "id": "fr-24", "original": "espèce d'idiot", "phonetic": "es-PESS dee-DYOH", "translation": "you idiot", "translation_de": "du Idiot", "literal": "Spezies von Idiot", "note": "'Espèce de…' wertet jede Beleidigung auf, indem sie taxonomisch wird.", "category": "banter", "severity": 1, "variants": null },
    { "id": "fr-25", "original": "pauvre type", "phonetic": "pohv TEEP", "translation": "sad sack", "translation_de": "armes Würstchen", "literal": "armer Kerl", "note": "Mitleid als Waffe. Vernichtend mit langsamem Kopfschütteln.", "category": "banter", "severity": 2, "variants": null },
    { "id": "fr-26", "original": "minable", "phonetic": "mee-NAHBL", "translation": "pathetic", "translation_de": "erbärmlich", "literal": "schäbig", "note": "Kalt, abweisend, sehr effektiv mit Pariser Akzent.", "category": "banter", "severity": 2, "variants": null },
    { "id": "fr-27", "original": "tocard", "phonetic": "toh-KAR", "translation": "loser", "translation_de": "Versager", "literal": "schlechtes Rennpferd", "note": "Pferderennen-Slang für einen Gaul, der nie gewinnt.", "category": "banter", "severity": 2, "variants": null },
    { "id": "fr-28", "original": "plouc", "phonetic": "plook", "translation": "hick", "translation_de": "Hinterwäldler", "literal": "von bretonischen Ortsnamen (Plou-)", "note": "Pariser Snobismus in einer Silbe destilliert. Nur mit Ironie verwenden.", "category": "banter", "severity": 2, "variants": null },
    { "id": "fr-29", "original": "crétin", "phonetic": "kreh-TAN", "translation": "cretin", "translation_de": "Kretin / Trottel", "literal": "Kretin", "note": "Im Französischen stärker als im Deutschen; Kapitän Haddocks Liebling.", "category": "frustration", "severity": 2, "variants": null },
    { "id": "fr-30", "original": "imbécile", "phonetic": "am-beh-SEEL", "translation": "imbecile", "translation_de": "Idiot / Schwachkopf", "literal": "Schwachsinniger", "note": "Klassisch, leicht literarisch. Molière-genehmigt.", "category": "frustration", "severity": 2, "variants": null },
    { "id": "fr-31", "original": "abruti", "phonetic": "ah-bruu-TEE", "translation": "moron", "translation_de": "Vollidiot", "literal": "verroht", "note": "Der Standard für andere Autofahrer.", "category": "frustration", "severity": 2, "variants": null },
    { "id": "fr-32", "original": "débile", "phonetic": "deh-BEEL", "translation": "moronic", "translation_de": "bescheuert", "literal": "schwach", "note": "'C'est débile' (das ist bescheuert) wird täglich ca. 400 Mal auf Französisch gesagt.", "category": "frustration", "severity": 2, "variants": null },
    { "id": "fr-33", "original": "merde", "phonetic": "maird", "translation": "shit", "translation_de": "Scheiße", "literal": "Scheiße", "note": "Bedeutet auch 'toi-toi-toi' für Schauspieler. Frankreich enthält Multitudes.", "category": "frustration", "severity": 2, "variants": null },
    { "id": "fr-34", "original": "bordel", "phonetic": "bor-DEL", "translation": "damn it / mess", "translation_de": "Mist / Chaos", "literal": "Bordell", "note": "'Quel bordel!' = was ein Chaos. Kombiniert wunderbar mit anderen Wörtern.", "category": "frustration", "severity": 2, "variants": null },
    { "id": "fr-35", "original": "fait chier", "phonetic": "feh shee-EH", "translation": "so annoying", "translation_de": "nervt total", "literal": "macht (einen) scheißen", "note": "'Ça me fait chier' ist die Nationalhymne der Montagmorgen.", "category": "frustration", "severity": 2, "variants": null },
    { "id": "fr-36", "original": "putain", "phonetic": "puu-TAN", "translation": "damn / fuck", "translation_de": "verdammt / Scheiße", "literal": "Hure", "note": "Im Süden ist es Interpunktion. Kann Freude, Wut, Ehrfurcht und Käsewertschätzung ausdrücken.", "category": "frustration", "severity": 3, "variants": null },
    { "id": "fr-37", "original": "con", "phonetic": "kohn", "translation": "idiot", "translation_de": "Idiot / Depp", "literal": "vulgär: Vulva", "note": "So überstrapaziert, dass es kaum noch registriert — 'le petit con' ist fast zärtlich.", "category": "banter", "severity": 2, "variants": null },
    { "id": "fr-38", "original": "connard", "phonetic": "koh-NAR", "translation": "asshole", "translation_de": "Arschloch", "literal": "con + abwertende Endung", "note": "Cons aggressiver großer Bruder. Standard-Verkehrsvokabular.", "category": "nuclear", "severity": 3, "variants": null },
    { "id": "fr-39", "original": "connasse", "phonetic": "koh-NASS", "translation": "asshole (feminine)", "translation_de": "Arschloch (weiblich)", "literal": "weibliche Form von connard", "note": "Grammatikalisch feminin, gleich unhöflich.", "category": "nuclear", "severity": 3, "variants": null },
    { "id": "fr-40", "original": "salaud", "phonetic": "sah-LOH", "translation": "bastard", "translation_de": "Dreckskerl", "literal": "Schmutziger", "note": "Sartre schrieb Philosophie über 'les salauds'. Beim Abendessen immer noch unhöflich.", "category": "nuclear", "severity": 3, "variants": null },
    { "id": "fr-41", "original": "salopard", "phonetic": "sah-loh-PAR", "translation": "scumbag", "translation_de": "Drecksack", "literal": "Schmutziger + Suffix", "note": "Salaud mit extra Kies in der Stimme.", "category": "nuclear", "severity": 3, "variants": null },
    { "id": "fr-42", "original": "enfoiré", "phonetic": "ahn-fwah-REH", "translation": "asshole", "translation_de": "Arschloch", "literal": "Beschmutzter", "note": "Paradox: auch der liebevolle Name einer beliebten Wohltätigkeits-Konzertgruppe.", "category": "nuclear", "severity": 3, "variants": null },
    { "id": "fr-43", "original": "ducon", "phonetic": "duu-KOHN", "translation": "dumbass", "translation_de": "Vollidiot", "literal": "von-dem-con", "note": "Verwandelt 'con' in einen falschen aristokratischen Nachnamen. Monsieur Ducon.", "category": "nuclear", "severity": 3, "variants": null },
    { "id": "fr-44", "original": "trou du cul", "phonetic": "troo duu KUU", "translation": "asshole", "translation_de": "Arschloch", "literal": "Arschloch", "note": "Anatomisch identisch mit der englischen Version. Globaler Konsens.", "category": "nuclear", "severity": 3, "variants": null },
    { "id": "fr-45", "original": "tête de nœud", "phonetic": "tet duh NUH", "translation": "dickhead", "translation_de": "Schwanzgesicht", "literal": "Knotenkopf", "note": "Klingt wie Segelterminologie. Ist keine Segelterminologie.", "category": "nuclear", "severity": 3, "variants": null },
    { "id": "fr-46", "original": "casse-couilles", "phonetic": "kass-KOO-yuh", "translation": "pain in the ass", "translation_de": "Nervensäge", "literal": "Hodenbrecher", "note": "Das grobe große Geschwister von casse-pieds.", "category": "nuclear", "severity": 3, "variants": null },
    { "id": "fr-47", "original": "emmerdeur", "phonetic": "ahn-mair-DUHR", "translation": "pain in the ass", "translation_de": "Nervensäge", "literal": "einer, der dich mit Scheiße bedeckt", "note": "Ein ganzer französischer Film (L'Emmerdeur, 1973) ehrt diese Person.", "category": "banter", "severity": 2, "variants": null },
    { "id": "fr-48", "original": "ta gueule", "phonetic": "tah GUHL", "translation": "shut up", "translation_de": "halt die Klappe", "literal": "dein (Tier-)Maul", "note": "'Gueule' (Tiermaul) für ein menschliches Gesicht zu verwenden ist die Beleidigung in der Beleidigung.", "category": "nuclear", "severity": 3, "variants": null },
    { "id": "fr-49", "original": "va te faire foutre", "phonetic": "vah tuh fair FOOTR", "translation": "go fuck yourself", "translation_de": "fick dich", "literal": "geh, lass dich machen", "note": "Das Ende der Eskalationsleiter. Danach kommt nichts mehr.", "category": "nuclear", "severity": 3, "variants": null },
    { "id": "fr-50", "original": "n'importe quoi", "phonetic": "nan-port KWAH", "translation": "utter nonsense", "translation_de": "totaler Unsinn", "literal": "egal was", "note": "Mit einem Augenrollen gesagt, entlässt es ganze Weltanschauungen. Gipfel des Französischen.", "category": "public", "severity": 1, "variants": null },
    { "id": "fr-51", "original": "avoir le cafard", "phonetic": "ah-VWAR luh kah-FAR", "translation": "to feel down", "translation_de": "deprimiert sein", "literal": "die Kakerlake haben", "note": "Wörtlich eine Kakerlake im Kopf haben. Für schlechte Tage und Montagsgefühle.", "category": "frustration", "severity": 1, "variants": null },
    { "id": "fr-52", "original": "poser un lapin", "phonetic": "poh-ZEH uh lah-PAN", "translation": "to stand someone up", "translation_de": "jemanden versetzen", "literal": "einen Hasen hinsetzen", "note": "Jemanden versetzen. Der Hase sitzt allein am Tisch. Grausam.", "category": "banter", "severity": 1, "variants": null },
    { "id": "fr-53", "original": "avoir le melon", "phonetic": "ah-VWAR luh muh-LOH", "translation": "to be big-headed", "translation_de": "eingebildet sein", "literal": "die Melone haben", "note": "Großer Kopf = großes Ego. Für selbstverliebte Typen.", "category": "banter", "severity": 1, "variants": null },
    { "id": "fr-54", "original": "casser les pieds", "phonetic": "kah-SEH leh PYEH", "translation": "to be a pain", "translation_de": "auf den Geist gehen", "literal": "die Füße brechen", "note": "Jemanden nerven. Milder als casse-couilles, aber gleiche Energie.", "category": "banter", "severity": 1, "variants": null },
    { "id": "fr-55", "original": "il ne tourne pas rond", "phonetic": "eel nuh TOORN pah ROH", "translation": "he's not right in the head", "translation_de": "er hat nicht alle Tassen im Schrank", "literal": "er dreht sich nicht rund", "note": "Motor-Metapher für geistige Instabilität. Sanfter als 'il est fou'.", "category": "playful", "severity": 1, "variants": null },
    { "id": "fr-56", "original": "tu me prends la tête", "phonetic": "tuu muh proh lah TET", "translation": "you're doing my head in", "translation_de": "du nervst mich zu Tode", "literal": "du nimmst mir den Kopf", "note": "Wenn jemand so nervt, dass er buchstäblich deinen Kopf wegnimmt.", "category": "frustration", "severity": 2, "variants": null },
    { "id": "fr-57", "original": "t'es gonflé", "phonetic": "teh goh-FLEH", "translation": "you've got a nerve", "translation_de": "du hast Nerven", "literal": "du bist aufgeblasen", "note": "Für unverschämte Dreistigkeit. 'Gonflé à bloc' = maximal dreist.", "category": "banter", "severity": 1, "variants": null },
    { "id": "fr-58", "original": "ça craint", "phonetic": "sah KRAN", "translation": "that sucks", "translation_de": "das ist zum Kotzen", "literal": "das fürchtet sich", "note": "Universelle Klage. 'Ça craint vraiment' = das ist wirklich zum Kotzen.", "category": "frustration", "severity": 1, "variants": null },
    { "id": "fr-59", "original": "tu déconnes", "phonetic": "tuu deh-KON", "translation": "you're talking crap", "translation_de": "du redest Unsinn", "literal": "du dekonnierst", "note": "Von 'con' abgeleitet. 'Arrête de déconner' = hör auf, Unsinn zu reden.", "category": "banter", "severity": 2, "variants": null },
    { "id": "fr-60", "original": "lâche-moi la grappe", "phonetic": "lahsh-mwah lah GRAP", "translation": "get off my back", "translation_de": "lass mich in Ruhe", "literal": "lass meine Weintraube los", "note": "Lass die Weintraube los = lass mich in Ruhe. Weinbauern-Ursprung.", "category": "frustration", "severity": 1, "variants": null }
  ]
