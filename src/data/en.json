    { "id": "en-14", "original": "jackass", "phonetic": "JAK-ass", "translation": "jackass", "literal": "male donkey", "note": "Technically just a donkey. Tell that to the person you called it.", "category": "frustration", "severity": 2, "variants": ["en-US"] },
    { "id": "en-15", "original": "douchebag", "phonetic": "DOOSH-bag", "translation": "obnoxious jerk", "literal": "hygiene device", "note": "Distinctly American; describes a very specific gym-mirror personality.", "category": "banter", "severity": 2, "variants": ["en-US"] },
