    { "id": "es-29", "original": "cazurro", "phonetic": "kah-SOO-roh", "translation": "pigheaded", "literal": "sullen / stubborn", "note": "Rural Spain's finest word for a mule in human form.", "category": "banter", "severity": 1, "variants": ["es-ES"] },
    { "id": "es-30", "original": "gilipollas", "phonetic": "khee-lee-POH-yahs", "translation": "asshole / jerk", "literal": "gilí (foolish) + pollas", "note": "THE Spanish insult. Spain runs on coffee, olive oil, and this word.", "category": "nuclear", "severity": 3, "variants": ["es-ES"] },
    { "id": "es-31", "original": "capullo", "phonetic": "kah-POO-yoh", "translation": "jerk", "literal": "cocoon / flower bud", "note": "Botanically innocent, socially devastating.", "category": "banter", "severity": 2, "variants": ["es-ES"] },
    { "id": "es-32", "original": "tonto del culo", "phonetic": "TON-toh del KOO-loh", "translation": "complete idiot", "literal": "silly of the arse", "note": "Anatomically upgraded tonto. Very Spain.", "category": "banter", "severity": 2, "variants": ["es-ES"] },
    { "id": "es-33", "original": "joder", "phonetic": "khoh-DAIR", "translation": "damn / fuck", "literal": "to fuck", "note": "Spain's all-purpose exclamation; conjugated less often than exclaimed.", "category": "frustration", "severity": 3, "variants": ["es-ES"] },
    { "id": "es-34", "original": "coño", "phonetic": "KOH-nyoh", "translation": "damn", "literal": "vulgar: vulva", "note": "In Spain it's punctuation; in parts of Latin America it's a real slap.", "category": "frustration", "severity": 3, "variants": ["es-ES"] },
    { "id": "es-35", "original": "hostia", "phonetic": "OS-tyah", "translation": "damn / whoa", "literal": "communion wafer", "note": "Blasphemy-powered. 'Hostia puta' is Spain's turbo mode.", "category": "frustration", "severity": 2, "variants": ["es-ES"] },
    { "id": "es-36", "original": "mamón", "phonetic": "mah-MOHN", "translation": "jerk / suck-up", "literal": "suckler", "note": "In Spain a jerk; in Mexico a pretentious one. Either way, unflattering.", "category": "banter", "severity": 2, "variants": null },
    { "id": "es-37", "original": "cabrón", "phonetic": "kah-BROHN", "translation": "bastard", "literal": "big male goat", "note": "In Mexico, 'qué cabrón' between friends can be pure admiration. Context is everything.", "category": "nuclear", "severity": 3, "variants": null },
    { "id": "es-38", "original": "pinche", "phonetic": "PEEN-cheh", "translation": "damn / lousy", "literal": "kitchen assistant", "note": "Mexico's favourite adjective. 'Pinche tráfico' = damn traffic.", "category": "frustration", "severity": 2, "variants": ["es-419"] },
