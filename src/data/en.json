    { "id": "en-07", "original": "clown", "phonetic": "klown", "translation": "clown", "literal": "clown", "note": "Modern internet-speak for someone whose decisions are a circus.", "category": "banter", "severity": 1, "variants": null },
    { "id": "en-08", "original": "couch potato", "phonetic": "KOWCH po-TAY-to", "translation": "lazy person", "literal": "potato on a couch", "note": "Coined in 1976; the potato has never moved since.", "category": "playful", "severity": 1, "variants": null },
