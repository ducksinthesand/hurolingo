    { "id": "en-11", "original": "smartass", "phonetic": "SMART-ass", "translation": "smart aleck", "translation_de": "Klugscheißer", "literal": "kluger Arsch", "note": "Im UK und Australien 'smart-arse' geschrieben, natürlich.", "category": "banter", "severity": 2, "variants": null },
