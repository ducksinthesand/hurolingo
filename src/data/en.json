    { "id": "en-01", "original": "idiot", "phonetic": "ID-ee-ut", "translation": "idiot", "literal": "idiot", "note": "The universal baseline. Works in every English-speaking country.", "category": "public", "severity": 1, "variants": null },
    { "id": "en-02", "original": "moron", "phonetic": "MOR-on", "translation": "moron", "literal": "moron", "note": "One notch above idiot on the frustration scale.", "category": "frustration", "severity": 1, "variants": null },
    { "id": "en-03", "original": "dipstick", "phonetic": "DIP-stick", "translation": "fool", "literal": "oil-measuring rod", "note": "Charmingly retro; peak usage in 1980s sitcoms.", "category": "playful", "severity": 1, "variants": null },
    { "id": "en-04", "original": "airhead", "phonetic": "AIR-hed", "translation": "scatterbrain", "literal": "head full of air", "note": "For friends who forget why they walked into the room.", "category": "playful", "severity": 1, "variants": null },
