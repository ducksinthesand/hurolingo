    { "id": "es-25", "original": "metiche", "phonetic": "meh-TEE-cheh", "translation": "busybody", "literal": "one who inserts themselves", "note": "The neighbour with breaking-news updates about your own life.", "category": "banter", "severity": 1, "variants": ["es-419"] },
    { "id": "es-26", "original": "chismoso", "phonetic": "chees-MOH-soh", "translation": "gossip", "literal": "gossipy", "note": "Every family group chat has at least two.", "category": "banter", "severity": 1, "variants": null },
    { "id": "es-27", "original": "aguafiestas", "phonetic": "ah-gwah-FYES-tahs", "translation": "party pooper", "literal": "party-waterer", "note": "The person who mentions Monday on a Saturday night.", "category": "playful", "severity": 1, "variants": null },
