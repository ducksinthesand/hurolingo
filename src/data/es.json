  "entries": [
    { "id": "es-01", "original": "tonto", "phonetic": "TON-toh", "translation": "silly", "literal": "silly", "note": "The baseline. 'Tonto del pueblo' = the village fool.", "category": "public", "severity": 1, "variants": null },
    { "id": "es-02", "original": "bobo", "phonetic": "BOH-boh", "translation": "silly / goofy", "literal": "silly", "note": "Even softer than tonto. Grandmother-approved.", "category": "playful", "severity": 1, "variants": null },
    { "id": "es-03", "original": "payaso", "phonetic": "pah-YAH-soh", "translation": "clown", "literal": "clown", "note": "Football fans' favourite word for referees across two continents.", "category": "banter", "severity": 2, "variants": null },
    { "id": "es-04", "original": "ganso", "phonetic": "GAHN-soh", "translation": "goofball", "literal": "goose", "note": "'Hacer el ganso' = to clown around.", "category": "playful", "severity": 1, "variants": null },
    { "id": "es-05", "original": "pavo", "phonetic": "PAH-voh", "translation": "dork", "literal": "turkey", "note": "Also teen slang for awkward: 'la edad del pavo' = the awkward age.", "category": "playful", "severity": 1, "variants": ["es-ES"] },
    { "id": "es-06", "original": "melón", "phonetic": "meh-LOHN", "translation": "melonhead", "literal": "melon", "note": "Big, round, hollow. Spain loves produce-based insults.", "category": "playful", "severity": 1, "variants": ["es-ES"] },
    { "id": "es-07", "original": "besugo", "phonetic": "beh-SOO-goh", "translation": "dimwit", "literal": "sea bream", "note": "A fish famous for its blank stare. 'Diálogo de besugos' = a dialogue of the deaf.", "category": "playful", "severity": 1, "variants": ["es-ES"] },
    { "id": "es-08", "original": "papanatas", "phonetic": "pah-pah-NAH-tahs", "translation": "simpleton", "literal": "cream-eater", "note": "Old-school and delightful to pronounce.", "category": "playful", "severity": 1, "variants": ["es-ES"] },
    { "id": "es-09", "original": "mequetrefe", "phonetic": "meh-keh-TREH-feh", "translation": "good-for-nothing", "literal": "meddler", "note": "Sounds like a spell from Harry Potter; means 'useless busybody'.", "category": "playful", "severity": 1, "variants": null },
    { "id": "es-10", "original": "zoquete", "phonetic": "soh-KEH-teh", "translation": "blockhead", "literal": "block of wood", "note": "Literally a chunk of wood. The Spanish Dummkopf.", "category": "playful", "severity": 1, "variants": null },
    { "id": "es-11", "original": "zopenco", "phonetic": "soh-PEN-koh", "translation": "dunce", "literal": "dunce", "note": "Rarely heard from anyone under 60, which makes it funnier.", "category": "playful", "severity": 1, "variants": null },
    { "id": "es-12", "original": "memo", "phonetic": "MEH-moh", "translation": "dimwit", "literal": "simpleton", "note": "Short and punchy; very Madrid.", "category": "banter", "severity": 1, "variants": ["es-ES"] },
    { "id": "es-13", "original": "lerdo", "phonetic": "LAIR-doh", "translation": "slowpoke", "literal": "slow / clumsy", "note": "For people who process life on dial-up.", "category": "banter", "severity": 1, "variants": null },
    { "id": "es-14", "original": "idiota", "phonetic": "ee-DYOH-tah", "translation": "idiot", "literal": "idiot", "note": "International vocabulary; works from Madrid to Buenos Aires.", "category": "frustration", "severity": 2, "variants": null },
    { "id": "es-15", "original": "imbécil", "phonetic": "eem-BEH-seel", "translation": "imbecile", "literal": "imbecile", "note": "A notch angrier than idiota.", "category": "frustration", "severity": 2, "variants": null },
    { "id": "es-16", "original": "estúpido", "phonetic": "es-TOO-pee-doh", "translation": "stupid", "literal": "stupid", "note": "Feels harsher in Spanish than English — use with intent.", "category": "frustration", "severity": 2, "variants": null },
    { "id": "es-17", "original": "tarado", "phonetic": "tah-RAH-doh", "translation": "idiot", "literal": "defective", "note": "Everyday word in Latin America, especially Argentina.", "category": "frustration", "severity": 2, "variants": ["es-419"] },
    { "id": "es-18", "original": "pesado", "phonetic": "peh-SAH-doh", "translation": "annoying / clingy", "literal": "heavy", "note": "The person whose texts arrive in stacks of nine.", "category": "banter", "severity": 1, "variants": null },
    { "id": "es-19", "original": "plasta", "phonetic": "PLAHS-tah", "translation": "bore", "literal": "sticky blob", "note": "Spain's word for someone who sticks to you at parties.", "category": "banter", "severity": 1, "variants": ["es-ES"] },
    { "id": "es-20", "original": "rata", "phonetic": "RAH-tah", "translation": "cheapskate", "literal": "rat", "note": "Universal; the friend who splits a coffee three ways.", "category": "banter", "severity": 1, "variants": null },
    { "id": "es-21", "original": "vago", "phonetic": "BAH-goh", "translation": "slacker", "literal": "wanderer / idle", "note": "The default parental accusation across the Spanish-speaking world.", "category": "banter", "severity": 1, "variants": null },
    { "id": "es-22", "original": "flojo", "phonetic": "FLOH-khoh", "translation": "lazy", "literal": "loose / slack", "note": "Latin American counterpart of vago.", "category": "banter", "severity": 1, "variants": ["es-419"] },
    { "id": "es-23", "original": "sinvergüenza", "phonetic": "seen-vair-GWEN-sah", "translation": "shameless rascal", "literal": "without shame", "note": "Somehow both an insult and a compliment, depending on the aunt saying it.", "category": "banter", "severity": 1, "variants": null },
