  "entries": [
    { "id": "fr-01", "original": "zut", "phonetic": "zuut", "translation": "darn", "literal": "darn", "note": "The mildest French curse; what teachers say when they drop chalk.", "category": "public", "severity": 1, "variants": null },
    { "id": "fr-02", "original": "mince", "phonetic": "manss", "translation": "shoot", "literal": "thin", "note": "Polite stand-in for 'merde', like saying 'sugar' instead of… you know.", "category": "public", "severity": 1, "variants": null },
    { "id": "fr-03", "original": "andouille", "phonetic": "ahn-DOO-yuh", "translation": "dummy", "literal": "tripe sausage", "note": "Being called a sausage is a French rite of passage.", "category": "playful", "severity": 1, "variants": null },
    { "id": "fr-04", "original": "cornichon", "phonetic": "kor-nee-SHOHN", "translation": "dope", "literal": "little pickle", "note": "France insults you with charcuterie-board items. Respect it.", "category": "playful", "severity": 1, "variants": null },
    { "id": "fr-05", "original": "patate", "phonetic": "pah-TAHT", "translation": "silly", "literal": "potato", "note": "Affectionate. 'Grosse patate' between friends is basically love.", "category": "playful", "severity": 1, "variants": null },
    { "id": "fr-06", "original": "banane", "phonetic": "bah-NAHN", "translation": "goof", "literal": "banana", "note": "Yes, the fruit-based insult family is large in France.", "category": "playful", "severity": 1, "variants": null },
    { "id": "fr-07", "original": "nouille", "phonetic": "NOO-yuh", "translation": "noodle / dimwit", "literal": "noodle", "note": "Soft, floppy, no spine. The metaphor writes itself.", "category": "playful", "severity": 1, "variants": null },
    { "id": "fr-08", "original": "cruche", "phonetic": "kruush", "translation": "airhead", "literal": "jug", "note": "Empty vessel, makes noise when tapped.", "category": "playful", "severity": 1, "variants": null },
    { "id": "fr-09", "original": "gourde", "phonetic": "goord", "translation": "dimwit", "literal": "flask / gourd", "note": "Like cruche but with outdoor-shop energy.", "category": "playful", "severity": 1, "variants": null },
    { "id": "fr-10", "original": "truffe", "phonetic": "truuf", "translation": "dolt", "literal": "truffle", "note": "The most expensive fungus becomes the cheapest insult.", "category": "playful", "severity": 1, "variants": null },
    { "id": "fr-11", "original": "quiche", "phonetic": "keesh", "translation": "klutz", "literal": "quiche", "note": "Modern slang: 'être une quiche en maths' = to be hopeless at maths.", "category": "playful", "severity": 1, "variants": null },
    { "id": "fr-12", "original": "boulet", "phonetic": "boo-LEH", "translation": "dead weight", "literal": "cannonball (on a chain)", "note": "The friend the group drags around like a prisoner's iron ball.", "category": "banter", "severity": 1, "variants": null },
    { "id": "fr-13", "original": "râleur", "phonetic": "rah-LUHR", "translation": "whiner", "literal": "groaner", "note": "Complaining is a national sport; a râleur is its professional athlete.", "category": "banter", "severity": 1, "variants": null },
    { "id": "fr-14", "original": "mytho", "phonetic": "mee-TOH", "translation": "liar", "literal": "short for mythomaniac", "note": "Teen slang for someone whose stories deserve a Netflix deal.", "category": "banter", "severity": 1, "variants": null },
    { "id": "fr-15", "original": "guignol", "phonetic": "geen-YOL", "translation": "clown", "literal": "the puppet Guignol", "note": "From the famous Lyon puppet theatre. 'Arrête ton guignol' = stop clowning.", "category": "banter", "severity": 1, "variants": null },
    { "id": "fr-16", "original": "bouffon", "phonetic": "boo-FOHN", "translation": "clown / fool", "literal": "court jester", "note": "Revived by banlieue slang; delivery matters more than the word.", "category": "banter", "severity": 2, "variants": null },
    { "id": "fr-17", "original": "blaireau", "phonetic": "bleh-ROH", "translation": "loser", "literal": "badger", "note": "Why the badger? Nobody knows. The badger did nothing wrong.", "category": "banter", "severity": 2, "variants": null },
    { "id": "fr-18", "original": "ringard", "phonetic": "ran-GAR", "translation": "uncool / has-been", "literal": "fire poker", "note": "Deadly in Paris, where being outdated is worse than being rude.", "category": "banter", "severity": 1, "variants": null },
    { "id": "fr-19", "original": "radin", "phonetic": "rah-DAN", "translation": "cheapskate", "literal": "stingy one", "note": "For the friend who 'forgot their wallet' four dinners in a row.", "category": "banter", "severity": 1, "variants": null },
    { "id": "fr-20", "original": "flemmard", "phonetic": "fleh-MAR", "translation": "lazybones", "literal": "one full of 'flemme'", "note": "'J'ai la flemme' (can't be bothered) is a complete French sentence and lifestyle.", "category": "playful", "severity": 1, "variants": null },
    { "id": "fr-21", "original": "tête de mule", "phonetic": "tet duh MUUL", "translation": "stubborn as a mule", "literal": "mule head", "note": "Standard-issue for family arguments.", "category": "banter", "severity": 1, "variants": null },
    { "id": "fr-22", "original": "casse-pieds", "phonetic": "kass-PYEH", "translation": "pain in the neck", "literal": "foot-breaker", "note": "The polite version of a much less polite expression below.", "category": "banter", "severity": 1, "variants": null },
    { "id": "fr-23", "original": "gros nul", "phonetic": "groh NUUL", "translation": "big loser", "literal": "big zero", "note": "Schoolyard classic; scales from playground to office.", "category": "banter", "severity": 1, "variants": null },
    { "id": "fr-24", "original": "espèce d'idiot", "phonetic": "es-PESS dee-DYOH", "translation": "you idiot", "literal": "species of idiot", "note": "'Espèce de…' upgrades any insult by making it taxonomic.", "category": "banter", "severity": 1, "variants": null },
    { "id": "fr-25", "original": "pauvre type", "phonetic": "pohv TEEP", "translation": "sad sack", "literal": "poor guy", "note": "Pity as a weapon. Devastating with a slow head-shake.", "category": "banter", "severity": 2, "variants": null },
    { "id": "fr-26", "original": "minable", "phonetic": "mee-NAHBL", "translation": "pathetic", "literal": "shabby", "note": "Cold, dismissive, very effective in a Parisian accent.", "category": "banter", "severity": 2, "variants": null },
    { "id": "fr-27", "original": "tocard", "phonetic": "toh-KAR", "translation": "loser", "literal": "bad racehorse", "note": "Horse-racing slang for a nag that never wins.", "category": "banter", "severity": 2, "variants": null },
    { "id": "fr-28", "original": "plouc", "phonetic": "plook", "translation": "hick", "literal": "from Breton place names (Plou-)", "note": "Parisian snobbery distilled into one syllable. Use with irony only.", "category": "banter", "severity": 2, "variants": null },
    { "id": "fr-29", "original": "crétin", "phonetic": "kreh-TAN", "translation": "cretin", "literal": "cretin", "note": "Stronger in French than English; a favourite of Captain Haddock.", "category": "frustration", "severity": 2, "variants": null },
    { "id": "fr-30", "original": "imbécile", "phonetic": "am-beh-SEEL", "translation": "imbecile", "literal": "imbecile", "note": "Classic, slightly literary. Molière-approved.", "category": "frustration", "severity": 2, "variants": null },
    { "id": "fr-31", "original": "abruti", "phonetic": "ah-bruu-TEE", "translation": "moron", "literal": "made brutish", "note": "The go-to for describing other drivers.", "category": "frustration", "severity": 2, "variants": null },
    { "id": "fr-32", "original": "débile", "phonetic": "deh-BEEL", "translation": "moronic", "literal": "feeble", "note": "'C'est débile' (that's idiotic) is said about 400 times per French day.", "category": "frustration", "severity": 2, "variants": null },
    { "id": "fr-33", "original": "merde", "phonetic": "maird", "translation": "shit", "literal": "shit", "note": "Also means 'break a leg' to actors. France contains multitudes.", "category": "frustration", "severity": 2, "variants": null },
    { "id": "fr-34", "original": "bordel", "phonetic": "bor-DEL", "translation": "damn it / mess", "literal": "brothel", "note": "'Quel bordel!' = what a mess. Combines beautifully with other words.", "category": "frustration", "severity": 2, "variants": null },
    { "id": "fr-35", "original": "fait chier", "phonetic": "feh shee-EH", "translation": "so annoying", "literal": "makes (one) shit", "note": "'Ça me fait chier' is the national anthem of Monday mornings.", "category": "frustration", "severity": 2, "variants": null },
    { "id": "fr-36", "original": "putain", "phonetic": "puu-TAN", "translation": "damn / fuck", "literal": "whore", "note": "In the south it's punctuation. Can express joy, rage, awe, and cheese appreciation.", "category": "frustration", "severity": 3, "variants": null },
    { "id": "fr-37", "original": "con", "phonetic": "kohn", "translation": "idiot", "literal": "vulgar: vulva", "note": "So overused it barely registers — 'le petit con' is almost tender.", "category": "banter", "severity": 2, "variants": null },
    { "id": "fr-38", "original": "connard", "phonetic": "koh-NAR", "translation": "asshole", "literal": "con + pejorative suffix", "note": "Con's aggressive big brother. Standard traffic vocabulary.", "category": "nuclear", "severity": 3, "variants": null },
    { "id": "fr-39", "original": "connasse", "phonetic": "koh-NASS", "translation": "asshole (feminine)", "literal": "feminine of connard", "note": "Grammatically feminine, equally rude.", "category": "nuclear", "severity": 3, "variants": null },
    { "id": "fr-40", "original": "salaud", "phonetic": "sah-LOH", "translation": "bastard", "literal": "dirty one", "note": "Sartre wrote philosophy about 'les salauds'. Still rude at dinner.", "category": "nuclear", "severity": 3, "variants": null },
    { "id": "fr-41", "original": "salopard", "phonetic": "sah-loh-PAR", "translation": "scumbag", "literal": "dirty one + suffix", "note": "Salaud with extra gravel in the voice.", "category": "nuclear", "severity": 3, "variants": null },
    { "id": "fr-42", "original": "enfoiré", "phonetic": "ahn-fwah-REH", "translation": "asshole", "literal": "soiled one", "note": "Paradox: also the affectionate name of a beloved charity concert group.", "category": "nuclear", "severity": 3, "variants": null },
    { "id": "fr-43", "original": "ducon", "phonetic": "duu-KOHN", "translation": "dumbass", "literal": "of-the-con", "note": "Turns 'con' into a fake aristocratic surname. Monsieur Ducon.", "category": "nuclear", "severity": 3, "variants": null },
    { "id": "fr-44", "original": "trou du cul", "phonetic": "troo duu KUU", "translation": "asshole", "literal": "hole of the arse", "note": "Anatomically identical to the English version. Global consensus.", "category": "nuclear", "severity": 3, "variants": null },
    { "id": "fr-45", "original": "tête de nœud", "phonetic": "tet duh NUH", "translation": "dickhead", "literal": "knot head", "note": "Sounds like sailing vocabulary. Is not sailing vocabulary.", "category": "nuclear", "severity": 3, "variants": null },
    { "id": "fr-46", "original": "casse-couilles", "phonetic": "kass-KOO-yuh", "translation": "pain in the ass", "literal": "ball-breaker", "note": "The rude big sibling of casse-pieds.", "category": "nuclear", "severity": 3, "variants": null },
    { "id": "fr-47", "original": "emmerdeur", "phonetic": "ahn-mair-DUHR", "translation": "pain in the ass", "literal": "one who covers you in shit", "note": "An entire French film (L'Emmerdeur, 1973) honours this person.", "category": "banter", "severity": 2, "variants": null },
    { "id": "fr-48", "original": "ta gueule", "phonetic": "tah GUHL", "translation": "shut up", "literal": "your (animal) mouth", "note": "Using 'gueule' (an animal's maw) for a human face is the insult inside the insult.", "category": "nuclear", "severity": 3, "variants": null },
    { "id": "fr-49", "original": "va te faire foutre", "phonetic": "vah tuh fair FOOTR", "translation": "go fuck yourself", "literal": "go get yourself done", "note": "The end of the escalation ladder. There is nothing after this.", "category": "nuclear", "severity": 3, "variants": null },
    { "id": "fr-50", "original": "n'importe quoi", "phonetic": "nan-port KWAH", "translation": "utter nonsense", "literal": "no matter what", "note": "Said with an eye-roll, it dismisses entire worldviews. Peak French.", "category": "public", "severity": 1, "variants": null }
  ]
