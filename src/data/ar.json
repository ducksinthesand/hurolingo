    { "id": "ar-04", "original": "يا حمار", "phonetic": "ya humar (yah hoo-MAR)", "translation": "you donkey", "literal": "O donkey", "note": "The classic across the whole Arab world. The donkey carries civilisation and its insults.", "category": "banter", "severity": 2, "variants": null },
    { "id": "ar-05", "original": "يا فاشل", "phonetic": "ya fashil (yah FAA-shil)", "translation": "you failure", "literal": "O failing one", "note": "Stings precisely because parents use it. Deploy carefully.", "category": "banter", "severity": 2, "variants": null },
