    { "id": "es-40", "original": "güey", "phonetic": "way", "translation": "dude / idiot", "literal": "from buey (ox)", "note": "Mexican Swiss Army knife: greeting, insult, and comma all at once.", "category": "banter", "severity": 1, "variants": ["es-419"] },
    { "id": "es-41", "original": "chingado", "phonetic": "cheen-GAH-doh", "translation": "damn / screwed", "literal": "from chingar (to screw)", "note": "The chingar verb family has ~50 meanings in Mexico. A national linguistics project.", "category": "frustration", "severity": 3, "variants": ["es-419"] },
    { "id": "es-42", "original": "boludo", "phonetic": "boh-LOO-doh", "translation": "dude / fool", "literal": "big-balled", "note": "Argentina's national word. 'Che, boludo' is how friendships breathe.", "category": "banter", "severity": 2, "variants": ["es-419"] },
