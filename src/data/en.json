  "entries": [
    { "id": "en-01", "original": "idiot", "phonetic": "ID-ee-ut", "translation": "idiot", "translation_de": "Idiot", "literal": "idiot", "note": "Der universelle Grundstein. Funktioniert in jedem englischsprachigen Land.", "category": "public", "severity": 1, "variants": null },
