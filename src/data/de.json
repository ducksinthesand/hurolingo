{
  "code": "de",
  "name": "Deutsch",
  "native": "Deutsch",
  "flag": "🇩🇪",
  "status": "full",
  "variants": [{ "code": "de-DE", "name": "Standarddeutsch", "flag": "🇩🇪" }],
  "entries": [
    { "id": "de-01", "original": "Mist", "phonetic": "mist", "translation": "Mist / Mist!", "literal": "Dung", "note": "Absolut gesellschaftsfähig — deutsche Omas sagen es stündlich.", "category": "public", "severity": 1, "variants": null },
    { "id": "de-02", "original": "Verdammt", "phonetic": "fair-DAMT", "translation": "Verdammt!", "literal": "Verdammt", "note": "Die Standardreaktion auf einen verpassten Zug — also selten, denn deutsche Züge sind nie zu spät (Scherz).", "category": "public", "severity": 1, "variants": null },
    { "id": "de-03", "original": "Blödsinn", "phonetic": "BLERD-zin", "translation": "Unsinn / Quatsch", "literal": "Blöder Sinn", "note": "Perfekt, um ein Argument abzuwimmeln, ohne zu fluchen.", "category": "public", "severity": 1, "variants": null },
    { "id": "de-04", "original": "Depp", "phonetic": "dep", "translation": "Trottel", "literal": "Trottel", "note": "In Bayern fast ein Kosewort.", "category": "banter", "severity": 1, "variants": null },
    { "id": "de-05", "original": "Trottel", "phonetic": "TROT-tel", "translation": "Dummkopf", "literal": "Trödler", "note": "Österreichischer Klassiker; mild und leicht liebevoll.", "category": "banter", "severity": 1, "variants": null },
    { "id": "de-06", "original": "Dummkopf", "phonetic": "DOOM-kopf", "translation": "Dummkopf", "literal": "Dummer Kopf", "note": "Die eine deutsche Beleidigung, die jeder Zeichentrick-Bösewicht der Welt beigebracht hat.", "category": "playful", "severity": 1, "variants": null },
    { "id": "de-07", "original": "Schwachkopf", "phonetic": "SHVAKH-kopf", "translation": "Hohlkopf", "literal": "Schwacher Kopf", "note": "Ein etwas fancigerer Dummkopf.", "category": "banter", "severity": 1, "variants": null },
    { "id": "de-08", "original": "Spinner", "phonetic": "SHPIN-ner", "translation": "Spinner", "literal": "Spinner", "note": "Von 'spinnen' — Garn spinnen, also Unsinn reden. 'Du spinnst!' = Du bist verrückt!", "category": "banter", "severity": 1, "variants": null },
    { "id": "de-09", "original": "Weichei", "phonetic": "VYKH-eye", "translation": "Weichling", "literal": "Weiches Ei", "note": "Teil einer ganzen Familie von Weichling-Beleidigungen, die Deutsche zum Spaß erfinden.", "category": "playful", "severity": 1, "variants": null },
    { "id": "de-10", "original": "Warmduscher", "phonetic": "VARM-doo-sher", "translation": "Weichling", "literal": "Warmduscher", "note": "Jemand, der zu weich ist, um kalt zu duschen. Gipfel der deutschen Komposita-Komödie.", "category": "playful", "severity": 1, "variants": null },
    { "id": "de-11", "original": "Schattenparker", "phonetic": "SHAT-ten-par-ker", "translation": "Weichling", "literal": "Schattenparker", "note": "Ein Mann, der im Schatten parkt, damit das Auto kühl bleibt. Vernichtend.", "category": "playful", "severity": 1, "variants": null },
    { "id": "de-12", "original": "Lappen", "phonetic": "LAP-pen", "translation": "Versager / Waschlappen", "literal": "Lappen", "note": "Jugendslang; auch das, was man verliert, wenn man beim Rasen erwischt wird (der Führerschein).", "category": "banter", "severity": 1, "variants": null },
    { "id": "de-13", "original": "Pfeife", "phonetic": "PFY-fuh", "translation": "Niete", "literal": "Pfeife", "note": "Jemand, der nur Luft macht. Beliebt bei Fußballtrainern.", "category": "banter", "severity": 1, "variants": null },
    { "id": "de-14", "original": "Flasche", "phonetic": "FLA-shuh", "translation": "Versager", "literal": "Flasche", "note": "Innen leer. 'Flasche leer!' wurde durch Trainer Trapattonis Ausraster legendär.", "category": "banter", "severity": 1, "variants": null },
    { "id": "de-15", "original": "Niete", "phonetic": "NEE-tuh", "translation": "Versager", "literal": "Niete (Lotterie)", "note": "Jemand, der nie etwas gewinnt — auch keine Argumente.", "category": "banter", "severity": 1, "variants": null },
    { "id": "de-16", "original": "Angsthase", "phonetic": "ANGST-hah-zuh", "translation": "Angsthase", "literal": "Angst-Hase", "note": "Harmlos genug für den Kindergarten, treffend genug für den Wanderfreund.", "category": "playful", "severity": 1, "variants": null },
    { "id": "de-17", "original": "Faulpelz", "phonetic": "FOWL-pelts", "translation": "Faulpelz", "literal": "Fauler Pelz", "note": "Für den Mitbewohner, dessen Geschirr bereits Bewusstsein entwickelt hat.", "category": "playful", "severity": 1, "variants": null },
    { "id": "de-18", "original": "Schnarchnase", "phonetic": "SHNARKH-nah-zuh", "translation": "Schlafmütze", "literal": "Schnarche-Nase", "note": "Für Menschen, die auch im Wachzustand schlafen.", "category": "playful", "severity": 1, "variants": null },
    { "id": "de-19", "original": "Klugscheißer", "phonetic": "KLOOG-shy-ser", "translation": "Klugscheißer", "literal": "Klug-Scheißer", "note": "Die Person, die mitten im Streit deine Grammatik korrigiert.", "category": "banter", "severity": 2, "variants": null },
    { "id": "de-20", "original": "Korinthenkacker", "phonetic": "ko-RIN-ten-KAK-ker", "translation": "Erbsenzähler", "literal": "Korinthen-Kacker", "note": "Jemand, dessen Pedanterie so winzige Ergebnisse produziert wie Korinthen.", "category": "banter", "severity": 2, "variants": null },
    { "id": "de-21", "original": "Erbsenzähler", "phonetic": "AIRB-zen-tsay-ler", "translation": "Erbsenzähler", "literal": "Erbsen-Zähler", "note": "Der Buchhalter der Lebensfreude. Zählt Erbsen, tötet die Stimmung.", "category": "playful", "severity": 1, "variants": null },
    { "id": "de-22", "original": "Sesselpupser", "phonetic": "ZES-sel-POOP-ser", "translation": "Schreibtischtäter", "literal": "Sessel-Pupser", "note": "Büroangestellter, der nie etwas Schwereres als einen Tacker gehoben hat.", "category": "playful", "severity": 1, "variants": null },
    { "id": "de-23", "original": "Suppenkasper", "phonetic": "ZOOP-pen-KAS-per", "translation": "Kostverächter", "literal": "Suppen-Kasper", "note": "Aus dem Kinderbuch Struwwelpeter von 1845 — der Junge, der seine Suppe verweigerte.", "category": "playful", "severity": 1, "variants": null },
    { "id": "de-24", "original": "Quatschkopf", "phonetic": "KVATCH-kopf", "translation": "Quatschkopf", "literal": "Quatsch-Kopf", "note": "Liebevoll; sicher einsetzbar bei Kindern und Vorstandsvorsitzenden gleichermaßen.", "category": "playful", "severity": 1, "variants": null },
    { "id": "de-25", "original": "Labertasche", "phonetic": "LAH-ber-TA-shuh", "translation": "Quasselstrippe", "literal": "Labert-Tasche", "note": "Für den Freund, dessen Sprachnachrichten 11 Minuten lang sind.", "category": "playful", "severity": 1, "variants": null },
    { "id": "de-26", "original": "Hosenscheißer", "phonetic": "HOH-zen-SHY-ser", "translation": "Feigling", "literal": "Hosen-Scheißer", "note": "Derb, aber meistens nur neckend unter Freunden verwendet.", "category": "banter", "severity": 2, "variants": null },
    { "id": "de-27", "original": "Halbdackel", "phonetic": "HALP-dak-kel", "translation": "Halbidiot", "literal": "Halber Dackel", "note": "Schwäbische Spezialität: ein ganzer Dackel ist schon eine Beleidigung — das hier ist die Hälfte davon.", "category": "banter", "severity": 2, "variants": null },
    { "id": "de-28", "original": "Honk", "phonetic": "honk", "translation": "Trottel", "literal": "(Kunstwort)", "note": "Jugendslang, angeblich von 'Hauptschüler ohne nennenswerte Kenntnisse'.", "category": "banter", "severity": 1, "variants": null },
    { "id": "de-29", "original": "Pappnase", "phonetic": "PAP-nah-zuh", "translation": "Clown", "literal": "Papp-Nase", "note": "Die rote Karnevalsnase — jemanden so zu nennen bedeutet, er ist ein Witz.", "category": "playful", "severity": 1, "variants": null },
    { "id": "de-30", "original": "Knalltüte", "phonetic": "KNAL-tuu-tuh", "translation": "Durchgeknallter", "literal": "Knall-Tüte", "note": "Ein Knaller von einer Person: laut, plötzlich, kein Inhalt.", "category": "banter", "severity": 1, "variants": null },
    { "id": "de-31", "original": "Dumpfbacke", "phonetic": "DOOMPF-bak-kuh", "translation": "Hohlkopf", "literal": "Dumpfe Backe", "note": "Bekannt gemacht durch die deutsche Synchronisation von 'Eine schrecklich nette Familie'.", "category": "banter", "severity": 1, "variants": null },
    { "id": "de-32", "original": "Lauch", "phonetic": "lowkh", "translation": "Schwächling", "literal": "Lauch (Gemüse)", "note": "Gym-Slang: dünn, blass, biegt sich leicht.", "category": "banter", "severity": 1, "variants": null },
    { "id": "de-33", "original": "Rotzlöffel", "phonetic": "ROTS-lerf-fel", "translation": "Frechdachs", "literal": "Rotz-Löffel", "note": "Reserviert für die Kinder anderer Leute.", "category": "playful", "severity": 1, "variants": null },
    { "id": "de-34", "original": "Jammerlappen", "phonetic": "YAM-mer-LAP-pen", "translation": "Jammerer", "literal": "Jammer-Lappen", "note": "Für Menschen, die über das Wetter klagen. Also alle.", "category": "banter", "severity": 1, "variants": null },
    { "id": "de-35", "original": "Miesepeter", "phonetic": "MEE-zuh-PAY-ter", "translation": "Miesepeter", "literal": "Mieser Peter", "note": "Armer Peter. Niemand weiß, was er getan hat, um das zu verdienen.", "category": "playful", "severity": 1, "variants": null },
    { "id": "de-36", "original": "Stinkstiefel", "phonetic": "SHTINK-shtee-fel", "translation": "Griesgram", "literal": "Stink-Stiefel", "note": "Verbreitet schlechte Laune so wie ein alter Stiefel Geruch verbreitet.", "category": "playful", "severity": 1, "variants": null },
    { "id": "de-37", "original": "Schwachmat", "phonetic": "SHVAKH-maht", "translation": "Schwachkopf", "literal": "Schwach-Matt", "note": "Umgangssprachliche Mischung aus 'schwach' und 'Schachmatt'.", "category": "banter", "severity": 1, "variants": null },
    { "id": "de-38", "original": "Scheiße", "phonetic": "SHY-suh", "translation": "Scheiße!", "literal": "Scheiße", "note": "Statistisch gesehen Deutschlands meistgenutztes Wort nach 'ja'. Passt in jede Situation.", "category": "frustration", "severity": 2, "variants": null },
    { "id": "de-39", "original": "Blödmann", "phonetic": "BLERD-man", "translation": "Blödmann", "literal": "Blöder Mann", "note": "Milder Klassiker; das deutsche Äquivalent zu 'Doofus'.", "category": "banter", "severity": 1, "variants": null },
    { "id": "de-40", "original": "Vollidiot", "phonetic": "FOL-ee-dee-OHT", "translation": "Vollidiot", "literal": "Voller Idiot", "note": "Das Präfix 'Voll-' wertet jede Beleidigung auf Premium auf.", "category": "frustration", "severity": 2, "variants": null },
    { "id": "de-41", "original": "Vollpfosten", "phonetic": "FOL-pfos-ten", "translation": "Vollpfosten", "literal": "Voller Zaunpfahl", "note": "So klug und nützlich wie ein Holzpfahl. Standardkommentar im Straßenverkehr.", "category": "frustration", "severity": 2, "variants": null },
    { "id": "de-42", "original": "Arschgeige", "phonetic": "ARSH-guy-guh", "translation": "Vollidiot", "literal": "Arsch-Geige", "note": "Niemand weiß, was eine Arschgeige ist — genau das macht sie perfekt.", "category": "banter", "severity": 2, "variants": null },
    { "id": "de-43", "original": "Arschkriecher", "phonetic": "ARSH-kree-kher", "translation": "Speichellecker", "literal": "Arsch-Kriecher", "note": "Für Kollegen, deren Zustimmung zum Chef tragend ist.", "category": "banter", "severity": 2, "variants": null },
    { "id": "de-44", "original": "Mistkerl", "phonetic": "MIST-kairl", "translation": "Dreckskerl", "literal": "Mist-Kerl", "note": "Altmodisch aber herzlich gemeint; was Oma TV-Bösewichte nennt.", "category": "frustration", "severity": 2, "variants": null },
    { "id": "de-45", "original": "Drecksack", "phonetic": "DREK-zak", "translation": "Drecksack", "literal": "Dreck-Sack", "note": "Ernste Beleidigung — der Freundschaftsrabatt gilt hier nicht.", "category": "nuclear", "severity": 3, "variants": null },
    { "id": "de-46", "original": "Kotzbrocken", "phonetic": "KOTS-bro-ken", "translation": "Widerling", "literal": "Kotzbrocken", "note": "Reserviert für Menschen, die auf molekularer Ebene anstrengend sind.", "category": "nuclear", "severity": 3, "variants": null },
    { "id": "de-47", "original": "Arschloch", "phonetic": "ARSH-lokh", "translation": "Arschloch", "literal": "Arsch-Loch", "note": "Der Schwergewichtschampion. Auch ein beliebtes deutsches Kartenspiel — verwirrenderweise.", "category": "nuclear", "severity": 3, "variants": null },
    { "id": "de-48", "original": "Verpiss dich", "phonetic": "fair-PISS dikh", "translation": "Verpiss dich", "literal": "Verpiß dich weg", "note": "Beendet Gespräche. Gelegentlich Freundschaften.", "category": "nuclear", "severity": 3, "variants": null },
    { "id": "de-49", "original": "Leck mich am Arsch", "phonetic": "LEK mikh am ARSH", "translation": "Leck mich am Arsch", "literal": "Leck mich am Arsch", "note": "Literarisches Erbe: Goethe hat es 1773 in ein Theaterstück geschrieben. Nationales Kulturgut.", "category": "nuclear", "severity": 3, "variants": null },
    { "id": "de-50", "original": "Hurensohn", "phonetic": "HOO-ren-zohn", "translation": "Hurensohn", "literal": "Sohn einer Hure", "note": "Extrem stark — Schlägerei-Starter-Territorium. Kennen, aber nicht werfen.", "category": "nuclear", "severity": 3, "variants": null }
  ]
}
