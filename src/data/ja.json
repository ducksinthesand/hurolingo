    { "id": "ja-08", "original": "けち", "phonetic": "kechi (KEH-chee)", "translation": "cheapskate", "literal": "stingy", "note": "For the colleague who calculates their share of lunch to the yen.", "category": "banter", "severity": 1, "variants": null },
